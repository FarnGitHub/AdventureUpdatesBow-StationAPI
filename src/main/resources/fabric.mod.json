{
  "schemaVersion": 1,
  "id": "adventure_update_bow",
  "version": "${version}",
  "name": "Adventure Update Bow",
  "description": "Change the Minecraft's bow to match with how it behave in adventure update",
  "authors": [
    "farnfarn02"
  ],
  "license": "MIT",
  "icon": "assets/adventure_update_bow/icon.png",
  "accessWidener": "adventure_update_bow.classTweaker",
  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "farn.adventure_update_bow.AdventureUpdateBow"
    ],
    "gcapi3": [
      "farn.adventure_update_bow.impl.config.AUBGlassConfig"
    ],
    "adventure_update_bow": [
      "farn.adventure_update_bow.impl.item.DefaultArrowListener",
      "farn.adventure_update_bow.compat.elemental_arrow.ElementalArrowListener",
      "farn.adventure_update_bow.compat.bhcreative.CreativeArrowListener"
    ]
  },
  "mixins": [
    "adventure_update_bow_mixin/main.mixins.json",
    "adventure_update_bow_mixin/aether.mixin.json",
    "adventure_update_bow_mixin/elemental.mixin.json"
  ],
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "stationapi": "*"
  }
}
